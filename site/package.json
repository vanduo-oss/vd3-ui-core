{
  "name": "@vd3-ui-core/site",
  "version": "1.0.0-draft",
  "private": true,
  "type": "module",
  "description": "Spec & SSG Documentation Bible for vd3-ui-core.",
  "scripts": {
    "predev": "mkdir -p public/tokens && cp ../tokens/vd3.tokens.json ../tokens/tokens.css ../tokens/schema.json public/tokens/",
    "dev": "vite",
    "build": "vite build && node ../scripts/build-ssg.mjs",
    "preview": "vite preview",
    "typecheck": "node ../scripts/verify-typecheck.mjs"
  },
  "dependencies": {
    "@vanduo-oss/vd3": "^1.9.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  }
}
