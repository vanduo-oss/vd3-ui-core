        "6": { "$value": "#fab005", "$description": "--vd-yellow-6 · default light primary" },
        "7": { "$value": "#f59f00", "$description": "--vd-yellow-7" }
      },
      "red": {
        "$description": "v1.9 Open Color red (--vd-red-*).",
        "4": { "$value": "#ff8787", "$description": "--vd-red-4" },
        "6": { "$value": "#fa5252", "$description": "--vd-red-6 · --vd-color-error" }
      }
    },
    "role": {
      "$type": "color",
      "$description": "Semantic roles — default (light) theme, v1.9-audited. Components consume ONLY these. Dark theme: theme.dark.color.role MUST define every role. Public CSS names follow v1.9 (--vd-bg-primary, --vd-text-primary, --vd-border-color, --vd-color-primary, --vd-color-error).",
      "canvas":         { "$value": "#ffffff",                  "$description": "v1.9 --vd-bg-primary (light). body background." },
      "layer":          { "$value": "{color.primitive.gray.0}",  "$description": "v1.9 --vd-bg-secondary (light)" },
      "layer-hover":    { "$value": "{color.primitive.gray.1}",  "$description": "v1.9 --vd-bg-tertiary (light)" },
      "text-primary":   { "$value": "{color.primitive.gray.1000}", "$description": "v1.9 --vd-text-primary" },
      "text-secondary": { "$value": "{color.primitive.gray.7}",  "$description": "v1.9 --vd-text-secondary / --vd-text-muted" },
      "border":         { "$value": "{color.primitive.gray.3}",  "$description": "v1.9 --vd-border-color" },
      "focus":          { "$value": "{color.primitive.gold.6}",  "$description": "v1.9 --vd-color-primary (default light primary = amber). v1.9 has NO dedicated focus-geometry tokens — ring width/offset are the F3-7 gap, new in v2." },
      "interactive":    { "$value": "{color.primitive.gold.7}",  "$description": "v1.9 --vd-color-primary-hover/dark" },
