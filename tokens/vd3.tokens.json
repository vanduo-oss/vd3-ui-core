        "2": { "$value": "#f20d91", "$description": "Step 2 · 318.0° · Magenta / Pink · H_2", "$extensions": { "vd3": { "class": "A", "derivation": "Golden angle phyllotaxis step 2" } } },
        "3": { "$value": "#68c20a", "$description": "Step 3 · 95.5° · Lime Green · H_3", "$extensions": { "vd3": { "class": "A", "derivation": "Golden angle phyllotaxis step 3" } } },
        "4": { "$value": "#254ef0", "$description": "Step 4 · 233.0° · Cobalt Blue · H_4", "$extensions": { "vd3": { "class": "A", "derivation": "Golden angle phyllotaxis step 4" } } },
