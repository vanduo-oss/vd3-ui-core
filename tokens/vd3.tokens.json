    "fast":    { "$value": "{motion.144}", "$description": "--vd-duration-fast" },
    "base":    { "$value": "{motion.233}", "$description": "--vd-duration-base · dropdowns, popovers, menus" },
    "slow":    { "$value": "{motion.377}", "$description": "--vd-duration-slow · drawers, modals" },
