      "$description": "Raw palette scales — v1.9 values (Open Color baseline: --vd-gray-*, --vd-yellow-*, --vd-red-*; Fibonacci golden-angle palette: --vd-fib-* / --vd-golden-*). Never consumed by components directly.",
      "gray": {
        "0":    { "$value": "#f8f9fa", "$description": "v1.9 --vd-gray-0" },
        "1":    { "$value": "#f1f3f5", "$description": "--vd-gray-1" },
        "2":    { "$value": "#e9ecef", "$description": "--vd-gray-2" },
        "3":    { "$value": "#dee2e6", "$description": "--vd-gray-3" },
        "4":    { "$value": "#ced4da", "$description": "--vd-gray-4" },
        "5":    { "$value": "#adb5bd", "$description": "--vd-gray-5" },
        "6":    { "$value": "#868e96", "$description": "--vd-gray-6" },
        "7":    { "$value": "#495057", "$description": "--vd-gray-7" },
        "8":    { "$value": "#343a40", "$description": "--vd-gray-8" },
        "9":    { "$value": "#212529", "$description": "--vd-gray-9" },
        "1000": { "$value": "#1a1d20", "$description": "--vd-bg-darker / --vd-text-primary baseline" }
      },
      "gold": {
        "$description": "v1.9 Open Color yellow family (--vd-yellow-*), the default light primary (amber).",
