    "fib-21": { "$value": "1.3125rem", "$description": "21px · --vd-radius-fib-21" },
    "full":   { "$value": "9999rem",   "$description": "Pill — shape semantic, not a scale step. Registered exception C-04." }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation ladder — v1.9 fib pairs confirmed in vd3-core.css: 1/2 (--vd-shadow-sm), 2/3 (--vd-shadow), 3/5 (--vd-shadow-md fib variant), 8/13 (--vd-shadow-lg fib), 13/21 (--vd-shadow-xl fib), 21/34 (--vd-shadow-2xl). Values below are the real light-theme composites; dark theme swaps alpha (#...4d/#...80). v1.9 ALSO ships conventional sm/md/lg/xl (tokens.json) — class B aliases.",
    "1": { "$value": "0 1px 2px #0000000d", "$description": "1/2 pair · --vd-shadow-sm" },
    "2": { "$value": "0 2px 3px 0 #0000001a, 0 1px 2px -1px #0000001a", "$description": "2/3 pair · --vd-shadow" },
    "3": { "$value": "0 3px 5px -1px #0000001a, 0 2px 3px -2px #0000001a", "$description": "3/5 pair · --vd-shadow-md (fib)" },
    "4": { "$value": "0 8px 13px -3px #0000001a, 0 3px 5px -3px #0000001a", "$description": "8/13 pair · --vd-shadow-lg (fib)" },
    "5": { "$value": "0 13px 21px -5px #0000001a, 0 5px 8px -5px #0000001a", "$description": "13/21 pair · --vd-shadow-xl (fib)" },
    "6": { "$value": "0 21px 34px -8px #00000040", "$description": "21/34 pair · --vd-shadow-2xl" }
  },
