      "shadow":         { "$value": "#0000001a",                 "$description": "Shadow ink, light theme (dark uses #0000004d). v1.9 fib shadows bake hex-alpha literals." }
    }
  },
  "theme": {
    "dark": {
      "color": {
        "role": {
          "$type": "color",
          "$description": "Dark theme — v1.9 [data-theme=\"dark\"] block values. MUST define every role from color.role.",
          "canvas":         { "$value": "{color.primitive.gray.9}" },
          "layer":          { "$value": "{color.primitive.gray.8}" },
          "layer-hover":    { "$value": "{color.primitive.gray.7}" },
