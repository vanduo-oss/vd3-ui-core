    "fib-2":  { "$value": "0.25rem",   "$description": "4px · C-01 · --vd-space-fib-2" },
    "fib-3":  { "$value": "0.375rem",  "$description": "6px · C-01 · --vd-space-fib-3" },
    "fib-5":  { "$value": "0.5rem",    "$description": "8px · C-01 · --vd-space-fib-5" },
    "fib-8":  { "$value": "0.75rem",   "$description": "12px · C-01 · --vd-space-fib-8" },
    "fib-13": { "$value": "0.8125rem", "$description": "13px · literal from here · --vd-space-fib-13" },
    "fib-21": { "$value": "1.3125rem", "$description": "21px · --vd-space-fib-21" },
    "fib-34": { "$value": "2.125rem",  "$description": "34px · --vd-space-fib-34" },
    "fib-55": { "$value": "3.4375rem", "$description": "55px · --vd-space-fib-55" }
  },
