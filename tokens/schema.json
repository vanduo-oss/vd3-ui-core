{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vd3.dev/tokens/schema.json",
  "title": "VD3 UI CORE Design Token Schema (DTCG 2.0)",
  "description": "JSON schema for VD3 UI CORE design tokens conforming to the W3C Design Tokens Community Group (DTCG) specification with VD3 mathematical extensions.",
  "type": "object",
  "required": ["$description", "$vd3", "math", "color", "space", "line", "radius", "shadow", "glow", "z", "container", "type", "motion", "easing", "aspect", "glass"],
  "properties": {
    "$description": { "type": "string" },
    "$vd3": {
      "type": "object",
      "required": ["spec"],
      "properties": {
        "spec": { "type": "string" },
        "auditedAgainst": { "type": "string" }
      }
    },
    "math": { "type": "object" },
    "color": { "type": "object" },
    "theme": { "type": "object" },
    "space": { "type": "object" },
    "line": { "type": "object" },
    "radius": { "type": "object" },
    "shadow": { "type": "object" },
    "glow": { "type": "object" },
    "z": { "type": "object" },
    "container": { "type": "object" },
    "breakpoint": { "type": "object" },
    "type": { "type": "object" },
    "motion": { "type": "object" },
    "easing": { "type": "object" },
    "aspect": { "type": "object" },
    "glass": { "type": "object" }
  },
  "definitions": {
    "basisClass": {
      "type": "string",
      "enum": ["A", "B", "C"]
    },
    "vd3Extensions": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": { "$ref": "#/definitions/basisClass" },
        "derivation": { "type": "string" },
        "reason": { "type": "string" },
        "exceptionId": {
          "type": "string",
          "enum": ["C-01", "C-02", "C-03", "C-04"]
        }
      }
    },
    "token": {
      "type": "object",
      "required": ["$value"],
      "properties": {
        "$value": {},
        "$type": { "type": "string" },
        "$description": { "type": "string" },
        "$extensions": {
          "type": "object",
          "properties": {
            "vd3": { "$ref": "#/definitions/vd3Extensions" }
          }
        }
      }
    }
  }
}
